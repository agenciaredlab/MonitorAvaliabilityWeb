# =============================================================================
# .env.example — Environment variables reference
# MonitorAvaliabilityWeb — Uptime Monitoring System
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Created by Agencia Redlab | Developed by Juan Camilo Medina Godoy
# =============================================================================

# ── Database (required) ───────────────────────────────────────────────────────
# Format: postgres://user:password@host:port/database
# In docker-compose: use service name "db" as host
# In Docker Swarm:   use service name "db" within the same overlay network
DATABASE_URL=postgres://monitor_user:monitor_pass@db:5432/monitor_db

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3000

# ── SMTP / Email alerts (optional) ───────────────────────────────────────────
# Leave all SMTP_ vars empty to disable email notifications.
# Gmail: enable 2FA and create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Destination address for DOWN / RECOVERY / SLA breach / SSL expiry emails
ALERT_EMAIL=alerts@yourdomain.com

# ── Slack alerts (optional) ──────────────────────────────────────────────────
# Create a webhook at api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── API key authentication (optional) ────────────────────────────────────────
# Set to "true" to require an API key for all private endpoints.
# Generate a key via: POST /api/keys  { "name": "My Key" }
REQUIRE_API_KEY=false

# ── Data retention (optional) ────────────────────────────────────────────────
# How many days to keep historical records before automatic cleanup (daily at 3 AM).
RETENTION_CHECKS_DAYS=90
RETENTION_ALERTS_DAYS=180
RETENTION_INCIDENTS_DAYS=365

# ── Docker Swarm / Portainer production ──────────────────────────────────────
# Public domain for Traefik routing (stack.yml)
DOMAIN=monitor.yourdomain.com

# Docker image to pull in Swarm deployments
# Format: registry/image:tag  (e.g. docker.io/myuser/uptime-monitor:latest)
REGISTRY_IMAGE=your-dockerhub-user/uptime-monitor:latest

# ── PostgreSQL credentials for Swarm db service (stack.yml / stack.standalone.yml)
POSTGRES_DB=monitor_db
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=monitor_pass
